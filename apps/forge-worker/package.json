{
  "name": "forge-worker",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./mirror-federation": "./src/mirror-federation.ts",
    "./test/*": "./test/*"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run && vitest run --config vitest.e2e.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "node --experimental-transform-types --no-warnings --expose-gc scripts/bench.ts",
    "instance-key": "node --experimental-transform-types --no-warnings scripts/instance-key.ts",
    "break-glass": "node --experimental-transform-types --no-warnings scripts/break-glass.ts",
    "bench:mirror": "node --experimental-transform-types --no-warnings scripts/bench-mirror.ts"
  },
  "dependencies": {
    "@git-forge/accounts": "workspace:*",
    "@git-forge/actions": "workspace:*",
    "@git-forge/cloudflare": "workspace:*",
    "@git-forge/core": "workspace:*",
    "@git-forge/notifications": "workspace:*",
    "@git-forge/releases": "workspace:*",
    "@git-forge/ses": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@git-forge/accounts-node": "workspace:*",
    "@git-forge/node": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.1"
  }
}

{
  "name": "forge-worker",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./mirror-federation": "./src/mirror-federation.ts",
    "./test/*": "./test/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev dist/server/entry.mjs --config wrangler.jsonc",
    "deploy": "astro build && wrangler deploy dist/server/entry.mjs --config wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && astro check",
    "test": "vitest run && vitest run --config vitest.pages.config.ts && vitest run --config vitest.e2e.config.ts && playwright test",
    "test:pages": "vitest run --config vitest.pages.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "playwright test",
    "bench": "node --experimental-transform-types --no-warnings --expose-gc scripts/bench.ts",
    "instance-key": "node --experimental-transform-types --no-warnings scripts/instance-key.ts",
    "bench:mirror": "node --experimental-transform-types --no-warnings scripts/bench-mirror.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@git-forge/accounts": "workspace:*",
    "@git-forge/actions": "workspace:*",
    "@git-forge/cloudflare": "workspace:*",
    "@git-forge/core": "workspace:*",
    "astro": "7.4.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261012.1",
    "@git-forge/accounts-node": "workspace:*",
    "@git-forge/node": "workspace:*",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.1"
  }
}

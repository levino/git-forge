---
import { codeRows, type HighlightedLine } from '../ui/highlight.ts'

type Props = { lines: readonly HighlightedLine[] }

const { lines } = Astro.props
---

<div class="overflow-x-auto">
  <table class="code-view hl" aria-label="File contents">
    <tbody set:html={codeRows(lines)} />
  </table>
</div>

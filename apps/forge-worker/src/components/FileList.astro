---
import type { CommitInfo, DirectoryEntry } from '@git-forge/core'
import { isoTime, relativeTime } from '../ui/format.ts'
import { blobUrl, commitUrl, type OpenRepository, treeUrl } from '../ui/repository.ts'
import Icon from './Icon.astro'

type Props = { repo: OpenRepository; refName: string; path: readonly string[]; entries: readonly DirectoryEntry[]; lfs?: ReadonlySet<string>; commits?: ReadonlyMap<string, CommitInfo> | null }

const { repo, refName, path, entries, lfs = new Set<string>(), commits = null } = Astro.props
const now = Math.floor(Date.now() / 1000)
const icon = (entry: DirectoryEntry) => (entry.kind === 'tree' ? 'folder' : entry.kind === 'submodule' ? 'submodule' : entry.kind === 'symlink' ? 'symlink' : lfs.has(entry.name) ? 'lfs' : 'file')
const href = (entry: DirectoryEntry) =>
  entry.kind === 'tree' ? treeUrl(repo.name, refName, [...path, entry.name]) : entry.kind === 'submodule' ? null : blobUrl(repo.name, refName, [...path, entry.name])
---

<table class="table table-sm" aria-label="Files">
  <tbody>
    {
      path.length > 0 && (
        <tr class="hover:bg-base-200/60">
          <td class="py-2" colspan={commits ? 3 : 1}>
            <a href={treeUrl(repo.name, refName, path.slice(0, -1))} class="flex items-center gap-2.5 hover:underline" aria-label="Parent directory">
              <Icon name="folder" class="size-4 text-primary/70" />
              ..
            </a>
          </td>
        </tr>
      )
    }
    {
      entries.map((entry) => (
        <tr class="hover:bg-base-200/60">
          <td class="flex items-center gap-2.5 min-w-0 py-2">
            <Icon name={icon(entry)} class:list={['size-4', entry.kind === 'tree' ? 'text-primary/70' : 'text-base-content/50']} />
            {href(entry) ? (
              <a href={href(entry)} class="hover:underline hover:text-primary truncate">
                {entry.name}
              </a>
            ) : (
              <span class="truncate">{entry.name}</span>
            )}
            {lfs.has(entry.name) && <span class="badge badge-xs">LFS</span>}
            <span class="sr-only">{entry.kind === 'tree' ? '(directory)' : entry.kind === 'submodule' ? '(submodule)' : ''}</span>
          </td>
          {commits && (
            <td class="hidden md:table-cell py-2 max-w-xs">
              {commits.get(entry.name) && (
                <a href={commitUrl(repo.name, commits.get(entry.name)!.id)} class="block truncate text-base-content/70 hover:underline hover:text-primary">
                  {commits.get(entry.name)!.summary}
                </a>
              )}
            </td>
          )}
          {commits && (
            <td class="py-2 text-right whitespace-nowrap text-xs text-base-content/60">
              {commits.get(entry.name) && <time datetime={isoTime(commits.get(entry.name)!.committer.timestamp)}>{relativeTime(commits.get(entry.name)!.committer.timestamp, now)}</time>}
            </td>
          )}
        </tr>
      ))
    }
  </tbody>
</table>

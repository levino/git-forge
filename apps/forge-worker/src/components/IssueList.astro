---
import type { Issue } from '@git-forge/collaboration'
import { isoTime, relativeTime } from '../ui/format.ts'
import { repoUrl, type OpenRepository } from '../ui/repository.ts'
import Icon from './Icon.astro'

type Props = { repo: OpenRepository; issues: readonly Issue[]; kind: 'issues' | 'pull' }

const { repo, issues, kind } = Astro.props
const now = Math.floor(Date.now() / 1000)
const seconds = (ms: number) => Math.floor(ms / 1000)
---

<ul class="border border-base-300 rounded-box divide-y divide-base-300" aria-label={kind === 'pull' ? 'Pull requests' : 'Issues'}>
  {
    issues.map((issue) => (
      <li class="flex items-start gap-3 px-4 py-2.5 hover:bg-base-200/50">
        <span title={issue.state === 'open' ? 'Open' : 'Closed'} class="mt-0.5">
          <Icon
            name={kind === 'pull' ? (issue.state === 'open' ? 'pull' : 'pull-closed') : issue.state === 'open' ? 'issue' : 'issue-closed'}
            class:list={['size-4', issue.state === 'open' ? 'text-success' : kind === 'pull' ? 'text-error' : 'text-secondary']}
          />
          <span class="sr-only">{issue.state === 'open' ? 'Open' : 'Closed'}</span>
        </span>
        <div class="min-w-0 flex-1">
          <a href={repoUrl(repo.name, kind, String(issue.number))} class="font-semibold hover:text-primary hover:underline break-words">
            {issue.title}
          </a>
          {issue.labels.map((label) => (
            <span class="badge badge-xs ml-1.5 align-middle border-0 font-medium" style={`background-color:#${label.color};color:#000`}>
              {label.name}
            </span>
          ))}
          <p class="text-xs text-base-content/60 mt-0.5">
            #{issue.number} opened <time datetime={isoTime(seconds(issue.createdAt))}>{relativeTime(seconds(issue.createdAt), now)}</time> by {issue.author.login}
          </p>
        </div>
        {issue.comments > 0 && (
          <span class="flex items-center gap-1 text-xs text-base-content/60" aria-label={`${issue.comments} comments`}>
            <Icon name="comment" class="size-3.5" />
            {issue.comments}
          </span>
        )}
      </li>
    ))
  }
</ul>

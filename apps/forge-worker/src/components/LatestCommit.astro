---
import type { CommitInfo, RepositoryName } from '@git-forge/core'
import { isoTime, relativeTime, shortId } from '../ui/format.ts'
import { commitUrl } from '../ui/repository.ts'

type Props = { repo: RepositoryName; commit: CommitInfo; historyHref?: string }

const { repo, commit, historyHref } = Astro.props
const now = Math.floor(Date.now() / 1000)
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 bg-base-200 text-sm">
  <span class="font-semibold">{commit.author.name}</span>
  <a href={commitUrl(repo, commit.id)} class="link link-hover truncate min-w-0 flex-1">{commit.summary}</a>
  <a href={commitUrl(repo, commit.id)} class="font-mono link link-hover text-base-content/70">{shortId(commit.id)}</a>
  <time datetime={isoTime(commit.committer.timestamp)} class="text-base-content/70">{relativeTime(commit.committer.timestamp, now)}</time>
  {historyHref && <a href={historyHref} class="link link-hover font-semibold">History</a>}
</div>

---
import Layout from '../layouts/Layout.astro'
import Icon from './Icon.astro'

type Props = { message?: string }

const { message = 'There is nothing here, or you do not have access to it.' } = Astro.props
const anonymous = Astro.locals.principal.kind === 'anonymous'
Astro.response.status = 404
---

<Layout title="Not found">
  <div class="py-16 flex justify-center">
    <div class="text-center max-w-md flex flex-col items-center gap-3">
      <Icon name="search" class="size-8 text-base-content/40" />
      <div>
        <h1 class="text-3xl font-semibold">404</h1>
        <p class="py-3 text-base-content/70">{message}</p>
        {anonymous && <a class="btn btn-primary" href={`/login?return_to=${encodeURIComponent(Astro.url.pathname)}`}>Sign in</a>}
      </div>
    </div>
  </div>
</Layout>

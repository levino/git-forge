---
import { cloneUrl, repoUrl, type OpenRepository } from '../ui/repository.ts'

type Tab = 'code' | 'commits' | 'branches' | 'tags' | 'settings'
type Props = { repo: OpenRepository; tab: Tab }

const { repo, tab } = Astro.props
const { name, subject } = repo
const mirror = repo.mirrors.find((config) => !config.detachedAt)
const tabs: { id: Tab; label: string; href: string; count?: number }[] = [
  { id: 'code', label: 'Code', href: repoUrl(name) },
  { id: 'commits', label: 'Commits', href: repoUrl(name, 'commits') },
  { id: 'branches', label: 'Branches', href: repoUrl(name, 'branches'), count: repo.branches.length },
  { id: 'tags', label: 'Tags', href: repoUrl(name, 'tags'), count: repo.tags.length },
  ...(repo.canAdmin ? [{ id: 'settings' as const, label: 'Settings', href: repoUrl(name, 'settings') }] : []),
]
const clone = cloneUrl(Astro.url.origin, name)
---

<div class="mb-6">
  <div class="flex flex-wrap items-center gap-2 mb-1">
    <h1 class="text-xl break-all">
      <a href={`/${name.owner}`} class="link link-hover">{name.owner}</a>
      <span class="text-base-content/50">/</span>
      <a href={repoUrl(name)} class="link link-hover font-semibold">{name.name}</a>
    </h1>
    <span class="badge badge-outline badge-sm">{subject.visibility === 'public' ? 'Public' : 'Private'}</span>
    {mirror && <span class="badge badge-info badge-outline badge-sm">Mirror</span>}
    <details class="dropdown dropdown-end ml-auto">
      <summary class="btn btn-sm btn-success">Clone</summary>
      <div class="dropdown-content card card-sm bg-base-100 border border-base-300 shadow-lg z-10 w-80 max-w-[90vw]">
        <div class="card-body">
          <label class="text-sm font-semibold" for="clone-url">Clone over HTTPS</label>
          <input id="clone-url" class="input input-sm w-full font-mono" readonly value={clone} />
        </div>
      </div>
    </details>
  </div>
  {
    mirror && (
      <p class="text-sm text-base-content/70 break-all">
        Mirror of <span class="font-mono">{mirror.url}</span>
      </p>
    )
  }
  <nav class="tabs tabs-border mt-4 overflow-x-auto flex-nowrap" aria-label="Repository">
    {
      tabs.map((item) => (
        <a href={item.href} class:list={['tab whitespace-nowrap', { 'tab-active': item.id === tab }]} aria-current={item.id === tab ? 'page' : undefined}>
          {item.label}
          {item.count !== undefined && <span class="badge badge-sm ml-2">{item.count}</span>}
        </a>
      ))
    }
  </nav>
</div>

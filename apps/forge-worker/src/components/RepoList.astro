---
import { isoTime, relativeTime } from '../ui/format.ts'
import { pageHref, type RepositoryPage } from '../ui/listing.ts'
import { repoUrl } from '../ui/repository.ts'
import EmptyState from './EmptyState.astro'
import Icon from './Icon.astro'
import Pager from './Pager.astro'

type Props = { listing: RepositoryPage; showOwner?: boolean; empty?: string; controls?: boolean }

const { listing, showOwner = true, empty = 'No repositories yet.', controls = true } = Astro.props
const now = Math.floor(Date.now() / 1000)
---

{
  controls && listing.total > 1 && (
    <div class="flex justify-end mb-2 text-xs gap-1" aria-label="Sort">
      {(['updated', 'name'] as const).map((sort) => (
        <a href={pageHref(Astro.url, { sort: sort === 'updated' ? null : sort, page: null })} class:list={['btn btn-xs', listing.sort === sort ? 'btn-active' : 'btn-ghost']} aria-current={listing.sort === sort ? 'true' : undefined}>
          {sort === 'updated' ? 'Last updated' : 'Name'}
        </a>
      ))}
    </div>
  )
}
{
  listing.items.length === 0 ? (
    <EmptyState icon="repo" title={empty} />
  ) : (
    <ul class="border border-base-300 rounded-box divide-y divide-base-300 bg-base-100" aria-label="Repositories">
      {listing.items.map((repo) => (
        <li class="flex items-start gap-3 px-4 py-3">
          <Icon name={repo.visibility === 'public' ? 'repo' : 'lock'} class="size-4 mt-0.5 text-base-content/50" />
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <a href={repoUrl(repo)} class="font-semibold text-primary hover:underline break-all">
                {showOwner ? `${repo.owner}/${repo.name}` : repo.name}
              </a>
              <span class="badge badge-sm">{repo.visibility === 'public' ? 'Public' : 'Private'}</span>
            </div>
            <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-base-content/60">
              {repo.defaultBranch && (
                <span class="flex items-center gap-1 font-mono">
                  <Icon name="branch" class="size-3.5" />
                  {repo.defaultBranch}
                </span>
              )}
              {repo.lastCommitAt !== null ? (
                <span>
                  Updated <time datetime={isoTime(Math.floor(repo.lastCommitAt / 1000))}>{relativeTime(Math.floor(repo.lastCommitAt / 1000), now)}</time>
                </span>
              ) : (
                <span>Empty</span>
              )}
            </p>
          </div>
        </li>
      ))}
    </ul>
  )
}
{controls && <Pager page={listing.page} more={listing.page * listing.perPage < listing.total} />}

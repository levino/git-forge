---
import Avatar from '../components/Avatar.astro'
import Icon from '../components/Icon.astro'
import { STYLESHEET_PATH } from '../ui/assets.ts'

type Props = { title: string; description?: string; wide?: boolean; narrow?: boolean; refresh?: number }

const { title, description, wide = false, narrow = false, refresh } = Astro.props
const principal = Astro.locals.principal
const session = Astro.locals.session
const login = principal.kind === 'user' ? principal.login : null
const host = Astro.url.host
const returnTo = Astro.url.pathname.startsWith('/-/') ? '/' : Astro.url.pathname
const instanceAdmin = session !== null && session !== undefined && (await Astro.locals.forge.instance.isAdministrator(session.principal))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="stylesheet" href={STYLESHEET_PATH} />
    {description && <meta name="description" content={description} />}
    {refresh !== undefined && <meta http-equiv="refresh" content={String(refresh)} />}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='4' cy='4' r='2.5' fill='%23f97316'/%3E%3Ccircle cx='12' cy='8' r='2.5' fill='%23f97316'/%3E%3Ccircle cx='4' cy='12' r='2.5' fill='%23f97316'/%3E%3Cpath d='M4 4v8M4 8h8' stroke='%23f97316' stroke-width='1.5' fill='none'/%3E%3C/svg%3E" />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content text-sm flex flex-col antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2 focus:bg-base-200">Skip to content</a>
    <header class="border-b border-base-300 bg-base-200">
      <nav class="max-w-7xl mx-auto px-4 h-14 flex items-center gap-2" aria-label="Main">
        <div class="flex-1 gap-5 flex items-center min-w-0">
          <a href="/" class="flex items-center gap-2 font-semibold text-base min-w-0">
            <Icon name="logo" class="size-6 text-primary" />
            <span class="truncate">{host}</span>
          </a>
          <a href="/explore" class="text-base-content/70 hover:text-base-content font-medium">Explore</a>
          <form action="/search" method="get" role="search" class="hidden md:block flex-1 max-w-xs">
            <input type="search" name="q" class="input input-sm w-full" placeholder="Search" aria-label="Search" />
          </form>
          <a href="/search" class="md:hidden btn btn-ghost btn-sm btn-square" aria-label="Search"><Icon name="search" /></a>
        </div>
        <div class="flex-none flex items-center gap-1">
          {
            session && (
              <a href="/new" class="btn btn-ghost btn-sm" aria-label="New repository">
                <Icon name="plus" />
                <span class="hidden sm:inline">New</span>
              </a>
            )
          }
          {
            session && (
              <a href="/notifications" class="btn btn-ghost btn-sm btn-square" aria-label="Notifications">
                <Icon name="bell" />
              </a>
            )
          }
          {
            login ? (
              <details class="dropdown dropdown-end">
                <summary class="btn btn-ghost btn-sm gap-2" aria-label={`Account menu (${login})`}>
                  <Avatar name={login} size={22} />
                  <span class="hidden sm:inline">{login}</span>
                  <Icon name="chevron" class="size-3.5 opacity-60" />
                </summary>
                <ul class="dropdown-content menu bg-base-100 border border-base-300 rounded-box shadow-md z-20 w-56 p-1.5 mt-1">
                  <li class="menu-title text-xs">Signed in as {login}</li>
                  <li>
                    <a href={`/${login}`}><Icon name="user" />Your profile</a>
                  </li>
                  {session && (
                    <li>
                      <a href="/settings"><Icon name="settings" />Settings</a>
                    </li>
                  )}
                  {session && (
                    <li>
                      <a href="/organizations/new"><Icon name="org" />New organization</a>
                    </li>
                  )}
                  {instanceAdmin && (
                    <li>
                      <a href="/-/admin"><Icon name="shield" />Instance administration</a>
                    </li>
                  )}
                  {session && (
                    <li class="border-t border-base-300 mt-1 pt-1">
                      <form method="post" action="/logout" class="p-0">
                        <input type="hidden" name="csrf" value={session.csrf} />
                        <button class="w-full flex items-center gap-2 text-left px-3 py-1.5"><Icon name="logout" />Sign out</button>
                      </form>
                    </li>
                  )}
                </ul>
              </details>
            ) : (
              <a href={`/login?return_to=${encodeURIComponent(returnTo)}`} class="btn btn-sm btn-primary">
                Sign in
              </a>
            )
          }
        </div>
      </nav>
    </header>
    <main id="main" class:list={['w-full mx-auto px-4 py-6 flex-1', wide ? 'max-w-[96rem]' : narrow ? 'max-w-4xl' : 'max-w-7xl']}>
      <slot />
    </main>
    <footer class="border-t border-base-300 text-xs text-base-content/60">
      <div class="max-w-7xl mx-auto px-4 py-4 flex items-center gap-2"><Icon name="logo" class="size-3.5" />Powered by git-forge</div>
    </footer>
    <script is:inline>
      document.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-clipboard]')
        if (!button) return
        const field = document.getElementById(button.dataset.clipboard)
        try {
          await navigator.clipboard.writeText(field.value)
        } catch {
          field.select()
          document.execCommand('copy')
        }
        button.toggleAttribute('data-copied', true)
        setTimeout(() => button.removeAttribute('data-copied'), 1500)
      })
    </script>
  </body>
</html>

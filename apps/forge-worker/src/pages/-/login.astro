---
import { accessLabel, CONSENT_WARNING, COPY_SCRIPT, formatRequestTime, PASSKEY_SCRIPT } from '@git-forge/accounts'
import AccessChoice from '../../components/AccessChoice.astro'
import NotFound from '../../components/NotFound.astro'
import Icon from '../../components/Icon.astro'
import Layout from '../../layouts/Layout.astro'
import { loginContentSecurityPolicy, loginPageTitle } from '../../ui/login-pages.ts'

const page = Astro.locals.loginPage
if (page) {
  Astro.response.status = page.kind === 'error' ? page.status : 200
  Astro.response.headers.set('Cache-Control', 'no-store')
  Astro.response.headers.set('X-Frame-Options', 'DENY')
  Astro.response.headers.set('Referrer-Policy', 'same-origin')
  Astro.response.headers.set('Content-Security-Policy', loginContentSecurityPolicy(page))
}
const config =
  (page?.kind === 'login' || page?.kind === 'invite') && !page.passkeys
    ? null
    : page?.kind === 'login'
    ? { returnTo: page.returnTo, csrf: page.user?.csrf ?? null }
    : page?.kind === 'invite'
      ? { returnTo: '/', csrf: null, invite: page.code }
      : null
const configJson = config ? JSON.stringify(config).replace(/</g, '\\u003c') : null
---

{
  !page ? (
    <NotFound />
  ) : (
    <Layout title={loginPageTitle(page)}>
      <div class="max-w-sm mx-auto mt-4 sm:mt-10 card border border-base-300 bg-base-100">
        <div class="card-body gap-4">
          <Icon name="logo" class="size-8 text-primary" />
          <h1 class="card-title text-xl">{loginPageTitle(page)}</h1>
          {page.kind === 'login' && page.message && <div role="alert" class="alert alert-warning">{page.message}</div>}
          {page.kind === 'login' && page.user && (
            <>
              <p>
                Signed in as <strong>{page.user.login}</strong>.
              </p>
              <div class="flex flex-wrap gap-2">
                <a class="btn btn-primary" href={page.returnTo}>
                  Continue
                </a>
                {page.passkeys && (
                  <button class="btn" type="button" data-passkey="register">
                    Add a passkey
                  </button>
                )}
                <form method="post" action="/logout">
                  <input type="hidden" name="csrf" value={page.user.csrf} />
                  <button class="btn btn-ghost">Sign out</button>
                </form>
              </div>
            </>
          )}
          {page.kind === 'login' && !page.user && (
            <>
              {page.oidcName && (
                <a class="btn btn-primary" href={`/login/oidc?return_to=${encodeURIComponent(page.returnTo)}`}>
                  Sign in with {page.oidcName}
                </a>
              )}
              {page.passkeys && (
                <button class="btn" type="button" data-passkey="login">
                  Sign in with a passkey
                </button>
              )}
              {page.passkeys && page.selfSignup && (
                <form class="flex flex-col gap-2" aria-label="Create an account">
                  <label class="text-sm font-semibold" for="login">
                    New account
                  </label>
                  <div class="join">
                    <input id="login" name="login" class="input join-item flex-1" autocomplete="username" required />
                    <button class="btn join-item" data-passkey="register">
                      Create with a passkey
                    </button>
                  </div>
                </form>
              )}
              {page.breakGlass && (
                <a class="link text-sm" href="/login/break-glass">
                  Break-glass login
                </a>
              )}
            </>
          )}
          {page.kind === 'invite' && (
            <>
              <p>
                You were invited
                {page.existingUser ? (
                  <>
                    {' '}
                    for <strong>{page.login}</strong>
                  </>
                ) : page.login ? (
                  <>
                    {' '}
                    as <strong>{page.login}</strong>
                  </>
                ) : (
                  ''
                )}
                .
              </p>
              {page.oidcName && (
                <a class="btn btn-primary" href={`/login/oidc?invite=${encodeURIComponent(page.code)}`}>
                  Continue with {page.oidcName}
                </a>
              )}
              {page.passkeys && (
                <form class="flex flex-col gap-2">
                  {!page.existingUser && !page.login && (
                    <>
                      <label class="text-sm font-semibold" for="login">
                        Login
                      </label>
                      <input id="login" name="login" class="input w-full" autocomplete="username" required />
                    </>
                  )}
                  <button class="btn" data-passkey="register">
                    Use a passkey
                  </button>
                </form>
              )}
            </>
          )}
          {page.kind === 'device' && (
            <>
              {page.message && <div role="alert" class="alert alert-warning">{page.message}</div>}
              {!page.device ? (
                <form method="get" action="/login/device" class="flex flex-col gap-2">
                  <label class="text-sm font-semibold" for="user_code">
                    Code shown on your device
                  </label>
                  <input id="user_code" name="user_code" class="input w-full font-mono uppercase tracking-widest" value={page.userCode ?? ''} autocomplete="off" required />
                  <button class="btn btn-primary">Continue</button>
                </form>
              ) : (
                <>
                  <p>
                    <strong>{page.device.clientName}</strong> asks for a token for Git, Git LFS and the API on <strong>{page.instance}</strong> on behalf of{' '}
                    <strong>{page.user.login}</strong>, with {accessLabel(page.device.scope)} access.
                  </p>
                  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm" aria-label="Request details">
                    <dt class="font-semibold">Device</dt>
                    <dd>{page.device.clientHost ?? 'not reported'} (reported by the device)</dd>
                    <dt class="font-semibold">Requested from</dt>
                    <dd>
                      {page.device.requestIp ?? 'unknown'}
                      {page.viewerIp && <span class="text-base-content/70"> (this browser: {page.viewerIp})</span>}
                    </dd>
                    <dt class="font-semibold">Requested at</dt>
                    <dd>{formatRequestTime(page.device.requestedAt)}</dd>
                    <dt class="font-semibold">Code</dt>
                    <dd>
                      <code class="font-mono tracking-widest">{page.device.userCode}</code>
                    </dd>
                  </dl>
                  <div role="alert" class="alert alert-warning">{CONSENT_WARNING}</div>
                  <form method="post" action="/login/device" class="flex flex-col gap-3">
                    <input type="hidden" name="csrf" value={page.user.csrf} />
                    <input type="hidden" name="user_code" value={page.device.userCode} />
                    <AccessChoice max={page.device.scope} />
                    <div class="flex gap-2">
                      <button class="btn btn-primary" name="decision" value="approve">
                        Approve
                      </button>
                      <button class="btn" name="decision" value="deny">
                        Deny
                      </button>
                    </div>
                  </form>
                </>
              )}
            </>
          )}
          {page.kind === 'cli' && (
            <>
              <p>
                Authorize <strong>{page.request.clientName}</strong>
                {page.request.clientHost && (
                  <>
                    {' '}
                    on <strong>{page.request.clientHost}</strong>
                  </>
                )}{' '}
                to act as <strong>{page.user.login}</strong> on <strong>{page.instance}</strong> with {accessLabel(page.request.scope)} access?
              </p>
              <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm" aria-label="Request details">
                <dt class="font-semibold">Requested from</dt>
                <dd>{page.request.requestIp ?? 'unknown'}</dd>
                <dt class="font-semibold">Requested at</dt>
                <dd>{formatRequestTime(page.request.requestedAt)}</dd>
              </dl>
              <p class="text-sm">
                {page.request.redirect === 'loopback' ? (
                  <>
                    The token goes to <code class="font-mono">{page.request.redirectUri}</code> on this computer.
                  </>
                ) : (
                  'You will get a one-time code to paste into your terminal.'
                )}
              </p>
              <div role="alert" class="alert alert-warning">{CONSENT_WARNING}</div>
              <form method="post" action={`/login/cli/${page.request.id}`} class="flex flex-col gap-3">
                <input type="hidden" name="csrf" value={page.user.csrf} />
                <AccessChoice max={page.request.scope} />
                <div class="flex gap-2">
                  <button class="btn btn-primary" name="decision" value="approve">
                    Approve
                  </button>
                  <button class="btn" name="decision" value="deny">
                    Deny
                  </button>
                </div>
              </form>
            </>
          )}
          {page.kind === 'cli-code' && (
            <>
              <p>Paste this one-time code into your terminal. It works once, only for the terminal that asked for it, and expires at {formatRequestTime(page.expiresAt)}.</p>
              <div class="join w-full">
                <input id="cli-code" class="input join-item flex-1 font-mono" readonly value={page.code} aria-label="Authorization code" />
                <button class="btn join-item" type="button" data-copy="cli-code">
                  Copy
                </button>
              </div>
              <script is:inline set:html={COPY_SCRIPT} />
            </>
          )}
          {page.kind === 'device-result' && <p>{page.approved ? 'You can close this window and return to your terminal.' : 'The device received no token.'}</p>}
          {page.kind === 'break-glass' && (
            <>
              {page.message && <div role="alert" class="alert alert-warning">{page.message}</div>}
              <p>Paste a token signed with the instance's offline break-glass key.</p>
              <form method="post" action="/login/break-glass" class="flex flex-col gap-2">
                <label class="sr-only" for="token">
                  Break-glass token
                </label>
                <textarea id="token" name="token" rows="6" class="textarea w-full font-mono" required />
                <button class="btn btn-primary">Sign in</button>
              </form>
            </>
          )}
          {page.kind === 'error' && (
            <>
              <div role="alert" class="alert alert-error">{page.message}</div>
              <a class="link" href="/login">
                Back to sign-in
              </a>
            </>
          )}
          <p id="message" role="alert" class="text-error empty:hidden" />
        </div>
      </div>
      {configJson && <script type="application/json" id="login-config" set:html={configJson} />}
      {configJson && <script is:inline set:html={PASSKEY_SCRIPT} />}
    </Layout>
  )
}

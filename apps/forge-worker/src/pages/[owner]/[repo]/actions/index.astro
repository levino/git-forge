---
import NotFound from '../../../../components/NotFound.astro'
import RepoHeader from '../../../../components/RepoHeader.astro'
import Layout from '../../../../layouts/Layout.astro'
import { branchOf, runState } from '../../../../ui/actions.ts'
import { isoTime, relativeTime, shortId } from '../../../../ui/format.ts'
import { openRepository, repoUrl } from '../../../../ui/repository.ts'

const { forge, principal } = Astro.locals
const repo = await openRepository(forge, principal, Astro.params.owner!, Astro.params.repo!)
const runs = repo.kind === 'ok' ? await forge.actions.runs(repo.name, 50) : []
const now = Math.floor(Date.now() / 1000)
const seconds = (ms: number) => Math.floor(ms / 1000)
---

{
  repo.kind !== 'ok' ? (
    <NotFound />
  ) : (
    <Layout title={`Actions · ${repo.name.owner}/${repo.name.name}`}>
      <RepoHeader repo={repo} tab="actions" />
      {runs.length === 0 ? (
        <p class="text-base-content/70">No workflow runs yet. Push a workflow under <code class="font-mono">.github/workflows/</code> to start one.</p>
      ) : (
        <ul class="border border-base-300 rounded-box divide-y divide-base-300" aria-label="Workflow runs">
          {runs.map((run) => (
            <li class="flex flex-wrap items-start gap-x-3 gap-y-1 px-4 py-3">
              <span class:list={['badge badge-sm mt-0.5', runState(run).badge]}>{runState(run).label}</span>
              <div class="min-w-0 flex-1">
                <a href={repoUrl(repo.name, 'actions', 'runs', String(run.id))} class="font-semibold link link-hover break-words">
                  {run.workflow_name}
                </a>
                <p class="text-sm text-base-content/70">
                  #{run.id} · {run.event} on <span class="font-mono">{branchOf(run.ref)}</span> · <span class="font-mono">{shortId(run.sha)}</span> by {run.actor}
                </p>
              </div>
              <time class="text-sm text-base-content/70" datetime={isoTime(seconds(run.created_at))}>{relativeTime(seconds(run.created_at), now)}</time>
            </li>
          ))}
        </ul>
      )}
    </Layout>
  )
}

---
import { can, createDiscussion, listCategories } from '@git-forge/collaboration'
import NotFound from '../../../../components/NotFound.astro'
import RepoHeader from '../../../../components/RepoHeader.astro'
import Layout from '../../../../layouts/Layout.astro'
import { field, type FormOutcome, runForm, scopeFor, unlessMissing } from '../../../../ui/collaboration.ts'
import { openRepository, repoUrl } from '../../../../ui/repository.ts'

const { forge, principal, session } = Astro.locals
const repo = await openRepository(forge, principal, Astro.params.owner!, Astro.params.repo!, { request: Astro.request })
if (repo.kind === 'ok' && !session) return Astro.redirect(`/login?return_to=${encodeURIComponent(Astro.url.pathname)}`)
let outcome: FormOutcome | null = null
if (repo.kind === 'ok' && Astro.request.method === 'POST') {
  outcome = await runForm(forge, Astro.request, repo, async (scope, form) => {
    const discussion = await createDiscussion(scope, { title: field(form, 'title'), body: field(form, 'body'), category: field(form, 'category') })
    return repoUrl(repo.name, 'discussions', String(discussion.number))
  })
  if (outcome.kind === 'redirect') return Astro.redirect(outcome.location, 303)
  Astro.response.status = outcome.status
}
const scope = repo.kind === 'ok' ? await scopeFor(forge, Astro.request, principal, repo) : null
const categories = scope && scope.settings.hasDiscussions ? ((await unlessMissing(listCategories(scope))) ?? []) : []
---

{
  repo.kind !== 'ok' || !scope || !session ? (
    <NotFound />
  ) : (
    <Layout title={`New discussion · ${repo.name.owner}/${repo.name.name}`}>
      <RepoHeader repo={repo} tab="discussions" />
      {outcome?.kind === 'error' && <div role="alert" class="alert alert-error mb-4">{outcome.message}</div>}
      {can(scope, 'discussion:create') && categories.length > 0 ? (
        <form method="post" class="flex flex-col gap-3 max-w-3xl" aria-label="New discussion">
          <input type="hidden" name="csrf" value={session.csrf} />
          <label class="text-sm font-semibold" for="category">Category</label>
          <select id="category" name="category" class="select w-full">
            {categories.map((category) => <option value={category.slug}>{category.emoji} {category.name}</option>)}
          </select>
          <label class="text-sm font-semibold" for="title">Title</label>
          <input id="title" name="title" class="input w-full" maxlength="256" required />
          <label class="text-sm font-semibold" for="body">Body</label>
          <textarea id="body" name="body" rows="10" class="textarea w-full font-mono" placeholder="Markdown is supported" required />
          <button class="btn btn-primary self-start">Start discussion</button>
        </form>
      ) : (
        <p>You cannot start discussions in this repository.</p>
      )}
    </Layout>
  )
}

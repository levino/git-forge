---
import { createFork } from '@git-forge/collaboration'
import NotFound from '../../../components/NotFound.astro'
import RepoHeader from '../../../components/RepoHeader.astro'
import Layout from '../../../layouts/Layout.astro'
import { field, type FormOutcome, runForm } from '../../../ui/collaboration.ts'
import { openRepository, repoUrl } from '../../../ui/repository.ts'

const { forge, principal, session } = Astro.locals
const repo = await openRepository(forge, principal, Astro.params.owner!, Astro.params.repo!, { request: Astro.request })
if (repo.kind === 'ok' && !session) return Astro.redirect(`/login?return_to=${encodeURIComponent(Astro.url.pathname)}`)
let outcome: FormOutcome | null = null
if (repo.kind === 'ok' && Astro.request.method === 'POST') {
  outcome = await runForm(forge, Astro.request, repo, async (scope, form, verified) => {
    const owner = field(form, 'owner')
    const fork = await createFork(scope, { organization: owner === verified.principal.login ? undefined : owner, name: field(form, 'name') })
    return repoUrl(fork)
  })
  if (outcome.kind === 'redirect') return Astro.redirect(outcome.location, 303)
  Astro.response.status = outcome.status
}
const owners = session ? await forge.repositories.owners(session.principal) : []
---

{
  repo.kind !== 'ok' || !session ? (
    <NotFound />
  ) : (
    <Layout title={`Fork · ${repo.name.owner}/${repo.name.name}`}>
      <RepoHeader repo={repo} tab="code" />
      {outcome?.kind === 'error' && <div role="alert" class="alert alert-error mb-4">{outcome.message}</div>}
      <form method="post" class="panel max-w-2xl" aria-label="Create a fork">
        <h2 class="panel-title">Create a fork</h2>
        <input type="hidden" name="csrf" value={session.csrf} />
        <div class="flex flex-wrap items-end gap-2">
          <label class="flex flex-col gap-1 text-sm font-semibold">
            Owner
            <select name="owner" class="select">
              {owners.map((owner) => <option selected={owner === session.principal.login}>{owner}</option>)}
            </select>
          </label>
          <span class="pb-2 text-lg" aria-hidden="true">/</span>
          <label class="flex flex-col gap-1 flex-1 min-w-40 text-sm font-semibold">
            Repository name
            <input name="name" class="input w-full" required maxlength="100" pattern="[A-Za-z0-9][A-Za-z0-9._\-]*" value={repo.name.name} />
          </label>
        </div>
        <button class="btn btn-primary self-start">Create fork</button>
      </form>
    </Layout>
  )
}

---
import NotFound from '../../../components/NotFound.astro'
import RepoHeader from '../../../components/RepoHeader.astro'
import TreeBrowser from '../../../components/TreeBrowser.astro'
import Layout from '../../../layouts/Layout.astro'
import { browse } from '../../../ui/browse.ts'
import { importStateFor } from '../../../ui/new-repository.ts'
import { latestRelease } from '../../../ui/releases.ts'
import { openRepository } from '../../../ui/repository.ts'

if (Astro.params.repo!.endsWith('.git')) return Astro.redirect(`/${Astro.params.owner}/${Astro.params.repo!.slice(0, -4)}`, 301)
const repo = await openRepository(Astro.locals.forge, Astro.locals.principal, Astro.params.owner!, Astro.params.repo!, { partial: true, request: Astro.request })
const [view, release] = repo.kind === 'ok' ? await Promise.all([browse(repo, [], 'tree'), latestRelease(Astro.locals.forge, repo)]) : [null, null]
const latest = view?.kind === 'tree' ? release : null
const imported = repo.kind === 'ok' && view?.kind === 'empty' ? await importStateFor(Astro.locals.forge, Astro.locals.session, repo.name) : null
---

{
  repo.kind !== 'ok' || !view || view.kind === 'not-found' || view.kind === 'blob' ? (
    <NotFound />
  ) : (
    <Layout title={`${repo.name.owner}/${repo.name.name}`}>
      <RepoHeader repo={repo} tab="code" />
      <TreeBrowser repo={repo} view={view} importing={imported !== null} latest={latest} />
    </Layout>
  )
}

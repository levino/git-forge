---
import { can, listIssues } from '@git-forge/collaboration'
import IssueList from '../../../../components/IssueList.astro'
import NotFound from '../../../../components/NotFound.astro'
import RepoHeader from '../../../../components/RepoHeader.astro'
import Layout from '../../../../layouts/Layout.astro'
import { scopeFor } from '../../../../ui/collaboration.ts'
import { parsePage } from '../../../../ui/history.ts'
import { openRepository, repoUrl } from '../../../../ui/repository.ts'

const { forge, principal } = Astro.locals
const repo = await openRepository(forge, principal, Astro.params.owner!, Astro.params.repo!)
const scope = repo.kind === 'ok' ? await scopeFor(forge, Astro.request, principal, repo) : null
const state = Astro.url.searchParams.get('state') === 'closed' ? 'closed' : 'open'
const page = parsePage(Astro.url.searchParams.get('page'))
const PER_PAGE = 25
const [list, open, closed] = scope
  ? await Promise.all([
      listIssues(scope, { state, kind: 'issue' }, { page, perPage: PER_PAGE }),
      listIssues(scope, { state: 'open', kind: 'issue' }, { page: 1, perPage: 1 }),
      listIssues(scope, { state: 'closed', kind: 'issue' }, { page: 1, perPage: 1 }),
    ])
  : [null, null, null]
---

{
  repo.kind !== 'ok' || !scope || !list || !open || !closed ? (
    <NotFound />
  ) : (
    <Layout title={`Issues · ${repo.name.owner}/${repo.name.name}`}>
      <RepoHeader repo={repo} tab="issues" />
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <nav class="join" aria-label="State">
          <a class:list={['join-item btn btn-sm', { 'btn-active': state === 'open' }]} href="?state=open" aria-current={state === 'open' ? 'page' : undefined}>
            {open.total} Open
          </a>
          <a class:list={['join-item btn btn-sm', { 'btn-active': state === 'closed' }]} href="?state=closed" aria-current={state === 'closed' ? 'page' : undefined}>
            {closed.total} Closed
          </a>
        </nav>
        {can(scope, 'issue:create') && (
          <a class="btn btn-sm btn-primary ml-auto" href={repoUrl(repo.name, 'issues', 'new')}>
            New issue
          </a>
        )}
      </div>
      {list.items.length === 0 ? <p class="text-base-content/70">No {state} issues.</p> : <IssueList repo={repo} issues={list.items} kind="issues" />}
      {(page > 1 || page * PER_PAGE < list.total) && (
        <nav class="join mt-6 flex justify-center" aria-label="Pagination">
          {page > 1 ? <a class="join-item btn btn-sm" href={`?state=${state}&page=${page - 1}`} rel="prev">Previous</a> : <span class="join-item btn btn-sm btn-disabled">Previous</span>}
          {page * PER_PAGE < list.total ? <a class="join-item btn btn-sm" href={`?state=${state}&page=${page + 1}`} rel="next">Next</a> : <span class="join-item btn btn-sm btn-disabled">Next</span>}
        </nav>
      )}
    </Layout>
  )
}

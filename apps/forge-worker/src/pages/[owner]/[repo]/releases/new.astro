---
import NotFound from '../../../../components/NotFound.astro'
import ReleaseForm from '../../../../components/ReleaseForm.astro'
import RepoHeader from '../../../../components/RepoHeader.astro'
import Layout from '../../../../layouts/Layout.astro'
import { releaseValues, type ReleaseFormResult, runReleaseForm } from '../../../../ui/releases.ts'
import { openRepository } from '../../../../ui/repository.ts'

const { forge, principal, session } = Astro.locals
const repo = await openRepository(forge, principal, Astro.params.owner!, Astro.params.repo!)
if (repo.kind === 'ok' && !session) return Astro.redirect(`/login?return_to=${encodeURIComponent(Astro.url.pathname)}`)
let result: ReleaseFormResult = { outcome: null, values: releaseValues(null, { tag: Astro.url.searchParams.get('tag') ?? '', target: repo.kind === 'ok' ? (repo.defaultBranch ?? '') : '' }) }
if (repo.kind === 'ok' && repo.canWrite && Astro.request.method === 'POST') {
  result = await runReleaseForm(forge, Astro.request, repo, null)
  if (result.outcome?.kind === 'redirect') return Astro.redirect(result.outcome.location, 303)
  if (result.outcome) Astro.response.status = result.outcome.status
}
---

{
  repo.kind !== 'ok' || !session || !repo.canWrite ? (
    <NotFound />
  ) : (
    <Layout title={`New release · ${repo.name.owner}/${repo.name.name}`}>
      <RepoHeader repo={repo} tab="releases" />
      <h1 class="text-xl font-semibold mb-4">New release</h1>
      {result.outcome?.kind === 'error' && <div role="alert" class="alert alert-error mb-4">{result.outcome.message}</div>}
      <ReleaseForm repo={repo} values={result.values} csrf={session.csrf} editing={false} />
    </Layout>
  )
}

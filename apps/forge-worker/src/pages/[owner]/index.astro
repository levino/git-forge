---
import Avatar from '../../components/Avatar.astro'
import Icon from '../../components/Icon.astro'
import NotFound from '../../components/NotFound.astro'
import RepoList from '../../components/RepoList.astro'
import Layout from '../../layouts/Layout.astro'
import { repositoryPage } from '../../ui/listing.ts'

const { forge, principal } = Astro.locals
const account = await forge.store.findAccount(Astro.params.owner!)
const repositories = account ? await repositoryPage(forge, principal, Astro.url, account.login) : null
const membership = account?.kind === 'organization' ? (await forge.organizations.view(principal, account.login)).membership !== null || (await forge.isInstanceAdmin(principal)) : false
const organization = account?.kind === 'organization'
---

{
  !account ? (
    <NotFound />
  ) : (
    <Layout title={account.login}>
      <div class="max-w-4xl mx-auto">
        <header class="flex flex-wrap items-center gap-4 pb-6 mb-6 border-b border-base-300">
          <Avatar name={account.login} size={56} square={organization} />
          <div class="min-w-0 flex-1">
            <h1 class="text-xl font-semibold break-all leading-tight">{account.displayName || account.login}</h1>
            <p class="flex items-center gap-1.5 text-base-content/60">
              <Icon name={organization ? 'org' : 'user'} class="size-3.5" />
              {account.displayName ? <span>{account.login}</span> : <span>{organization ? 'Organization' : 'User'}</span>}
            </p>
          </div>
          {organization && membership && (
            <a class="btn btn-sm" href={`/orgs/${account.login}`}>
              <Icon name="users" />
              People and teams
            </a>
          )}
        </header>
        <section aria-labelledby="repositories">
          <h2 id="repositories" class="text-base font-semibold mb-3 flex items-center gap-2">
            <Icon name="repo" class="size-4 text-base-content/60" />
            Repositories <span class="badge badge-sm">{repositories?.total}</span>
          </h2>
          {repositories && <RepoList listing={repositories} showOwner={false} />}
        </section>
      </div>
    </Layout>
  )
}

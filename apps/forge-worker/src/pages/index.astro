---
import Icon from '../components/Icon.astro'
import RepoList from '../components/RepoList.astro'
import Layout from '../layouts/Layout.astro'
import { repositoryPage } from '../ui/listing.ts'

const { forge, principal } = Astro.locals
const login = principal.kind === 'user' ? principal.login : null
const repositories = await repositoryPage(forge, principal, Astro.url, login ?? undefined, login ? undefined : 20)
const claimable = !login && (await forge.instance.claimable())
---

<Layout title={Astro.url.host}>
  {
    login ? (
      <section aria-labelledby="your-repositories" class="max-w-4xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <h1 id="your-repositories" class="text-lg font-semibold">
            Your repositories
          </h1>
          <div class="flex gap-2">
            <a href="/explore" class="btn btn-sm">
              <Icon name="search" />
              Explore
            </a>
            {Astro.locals.session && (
              <a href="/new" class="btn btn-primary btn-sm">
                <Icon name="plus" />
                New
              </a>
            )}
          </div>
        </div>
        <RepoList listing={repositories} showOwner={false} empty="You have no repositories yet." />
      </section>
    ) : (
      <div class="max-w-4xl mx-auto">
        {claimable && (
          <div role="status" class="alert alert-info mb-6">
            <Icon name="shield" />
            <span>This instance has no admin yet.</span>
            <a href="/-/setup" class="btn btn-sm btn-primary">Set it up</a>
          </div>
        )}
        <section class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-6 border-b border-base-300" aria-label="About">
          <p class="text-base-content/70 max-w-xl">Git repositories with Git LFS, issues, pull requests and actions, served by git-forge.</p>
          <div class="flex gap-2">
            <a href="/explore" class="btn btn-sm">
              <Icon name="search" />
              Explore repositories
            </a>
            <a href="/login" class="btn btn-sm btn-primary">
              Sign in
            </a>
          </div>
        </section>
        <section aria-labelledby="recent">
          <h1 id="recent" class="text-lg font-semibold mb-3">
            Public repositories
          </h1>
          <RepoList listing={repositories} controls={false} empty="There are no public repositories yet." />
        </section>
      </div>
    )
  }
</Layout>

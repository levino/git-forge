---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Sign in">
  <div class="max-w-md mx-auto card bg-base-200">
    <div class="card-body">
      <h1 class="card-title text-2xl">Sign in</h1>
      <p>Interactive sign-in is not available on this instance yet.</p>
      <p class="text-sm text-base-content/70">Git, Git LFS and the API accept personal access tokens.</p>
    </div>
  </div>
</Layout>

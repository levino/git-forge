---
import { PASSKEY_SCRIPT } from '@git-forge/accounts'
import AccessChoice from '../components/AccessChoice.astro'
import Layout from '../layouts/Layout.astro'
import { accountAction, type AccountAction, EXPIRY_DAYS } from '../ui/account.ts'
import { isoTime } from '../ui/format.ts'

const { forge } = Astro.locals
let session = Astro.locals.session
if (!session) return Astro.redirect(`/login?return_to=${encodeURIComponent('/settings')}`)
let result: AccountAction | null = null
if (Astro.request.method === 'POST') {
  const verified = await forge.verifySessionWrite(Astro.request)
  if (!verified) {
    Astro.response.status = 403
    result = { kind: 'error', message: 'The form expired. Reload the page and try again.' }
  } else {
    session = verified
    result = await accountAction(forge, verified, await Astro.request.formData(), Date.now())
    if (result.kind === 'error') Astro.response.status = 400
  }
}
Astro.response.headers.set('Cache-Control', 'no-store')
const user = session.principal
const methods = await forge.loginMethods()
const passkeysEnabled = methods.passkeys
const [tokens, passkeys, identities, sessions] = await Promise.all([forge.account.listTokens(user), passkeysEnabled ? forge.account.listPasskeys(user) : [], forge.account.listIdentities(user), forge.account.listSessions(user)])
const oidcName = methods.oidcName
const day = (ms: number | null) => (ms === null ? 'never' : isoTime(Math.floor(ms / 1000)).slice(0, 10))
const configJson = JSON.stringify({ returnTo: '/settings', csrf: session.csrf }).replace(/</g, '\\u003c')
---

<Layout title="Settings" narrow>
  <div class="flex flex-wrap items-center gap-3 mb-5">
    <h1 class="text-xl font-semibold">Settings for {user.login}</h1>
    <a class="btn btn-sm ml-auto" href="/settings/apps">GitHub Apps</a>
  </div>
  {
    result?.kind === 'token-created' && (
      <div role="status" class="alert alert-success mb-6 flex-col items-start">
        <p>
          Token <strong>{result.name}</strong> created. Copy it now, it is not shown again:
        </p>
        <input class="input w-full font-mono" readonly value={result.token} aria-label="Your new token" />
      </div>
    )
  }
  {result?.kind === 'token-revoked' && <div role="status" class="alert alert-success mb-6">Token revoked.</div>}
  {result?.kind === 'passkey-removed' && <div role="status" class="alert alert-success mb-6">Passkey removed.</div>}
  {result?.kind === 'identity-unlinked' && <div role="status" class="alert alert-success mb-6">Account unlinked.</div>}
  {result?.kind === 'session-revoked' && <div role="status" class="alert alert-success mb-6">Session ended.</div>}
  {result?.kind === 'renamed' && <div role="status" class="alert alert-success mb-6">Your account is now {result.login}.</div>}
  {result?.kind === 'error' && <div role="alert" class="alert alert-error mb-6">{result.message}</div>}

  <section class="panel" aria-labelledby="tokens">
    <h2 id="tokens" class="panel-title">Personal access tokens</h2>
    <p class="text-base-content/70">For Git, Git LFS and the API. Use them as password with any user name.</p>
    {
      tokens.length > 0 && (
        <div class="overflow-x-auto border border-base-300 rounded-box">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Name</th>
                <th>Scopes</th>
                <th>Expires</th>
                <th>Last used</th>
                <th>Status</th>
                <th>
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {tokens.map((token) => (
                <tr>
                  <td>
                    {token.name} <span class="font-mono text-xs text-base-content/60">{token.displayPrefix}…</span>
                  </td>
                  <td class="font-mono text-xs">{token.scopes.join(' ')}</td>
                  <td>{day(token.expiresAt)}</td>
                  <td>{token.lastUsedAt === null ? 'never' : day(token.lastUsedAt)}</td>
                  <td>
                    <span class:list={['badge badge-sm', token.status === 'active' ? 'badge-success' : 'badge-ghost']}>{token.status}</span>
                  </td>
                  <td>
                    {token.status === 'active' && (
                      <form method="post">
                        <input type="hidden" name="csrf" value={session.csrf} />
                        <input type="hidden" name="action" value="revoke-token" />
                        <input type="hidden" name="id" value={token.id} />
                        <button class="btn btn-xs btn-error btn-outline" aria-label={`Revoke ${token.name}`}>
                          Revoke
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    <form method="post" class="flex flex-col gap-3 max-w-md border-t border-base-300 pt-4" aria-label="Create a token">
      <div class="contents">
        <h3 class="font-semibold">New token</h3>
        <input type="hidden" name="csrf" value={session.csrf} />
        <input type="hidden" name="action" value="create-token" />
        <label class="text-sm font-semibold" for="token-name">Name</label>
        <input id="token-name" name="name" class="input w-full" maxlength="100" required />
        <AccessChoice selected="repo:write" />
        <label class="text-sm font-semibold" for="token-expires">Expires</label>
        <select id="token-expires" name="expires" class="select w-full">
          {EXPIRY_DAYS.map((days) => <option value={String(days)} selected={days === 90}>in {days} days</option>)}
          <option value="never">never</option>
        </select>
        <button class="btn btn-primary self-start">Create token</button>
      </div>
    </form>
  </section>

  {
    passkeysEnabled && (
    <section class="panel" aria-labelledby="passkeys">
      <h2 id="passkeys" class="panel-title">Passkeys</h2>
      {
        passkeys.length === 0 ? (
          <p class="text-base-content/70">No passkeys yet.</p>
        ) : (
          <ul class="border border-base-300 rounded-box divide-y divide-base-300">
            {passkeys.map((passkey) => (
              <li class="flex flex-wrap items-center gap-3 px-4 py-3">
                <span class="font-semibold">{passkey.name}</span>
                <span class="text-sm text-base-content/70">
                  added {day(passkey.createdAt)}, last used {passkey.lastUsedAt === null ? 'never' : day(passkey.lastUsedAt)}
                </span>
                <form method="post" class="ml-auto">
                  <input type="hidden" name="csrf" value={session.csrf} />
                  <input type="hidden" name="action" value="remove-passkey" />
                  <input type="hidden" name="id" value={passkey.id} />
                  <button class="btn btn-xs btn-error btn-outline" aria-label={`Remove passkey ${passkey.name}`}>
                    Remove
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )
      }
      <button class="btn btn-sm self-start" type="button" data-passkey="register">Add a passkey</button>
      <p id="message" role="alert" class="text-error empty:hidden"></p>
    </section>
    )
  }

  <section class="panel" aria-labelledby="identities">
    <h2 id="identities" class="panel-title">Linked accounts</h2>
    {
      identities.length === 0 ? (
        <p class="text-base-content/70">No linked accounts.</p>
      ) : (
        <ul class="border border-base-300 rounded-box divide-y divide-base-300">
          {identities.map((identity) => (
            <li class="flex flex-wrap items-center gap-3 px-4 py-3">
              <span class="font-mono text-sm break-all flex-1">{identity.issuer}</span>
              {identity.email && <span class="text-sm text-base-content/70">{identity.email}</span>}
              <span class="text-sm text-base-content/70">linked {day(identity.createdAt)}</span>
              <form method="post">
                <input type="hidden" name="csrf" value={session.csrf} />
                <input type="hidden" name="action" value="unlink-identity" />
                <input type="hidden" name="issuer" value={identity.issuer} />
                <input type="hidden" name="subject" value={identity.subject} />
                <button class="btn btn-xs btn-error btn-outline" aria-label={`Unlink ${identity.issuer}`}>Unlink</button>
              </form>
            </li>
          ))}
        </ul>
      )
    }
    {
      oidcName && (
        <a class="btn btn-sm self-start" href={`/login/oidc?link=1&return_to=${encodeURIComponent('/settings')}`}>
          Link a {oidcName} account
        </a>
      )
    }
  </section>

  <section class="panel" aria-labelledby="sessions">
    <h2 id="sessions" class="panel-title">Sessions</h2>
    <ul class="border border-base-300 rounded-box divide-y divide-base-300">
      {sessions.map((item) => (
        <li class="flex flex-wrap items-center gap-3 px-4 py-3">
          <span class="badge badge-sm">{item.method}</span>
          <span class="text-sm break-all flex-1">{item.userAgent ?? 'unknown browser'}</span>
          <span class="text-sm text-base-content/70">since {day(item.createdAt)}, last seen {day(item.lastSeenAt)}</span>
          {item.id === session.sessionId ? (
            <span class="badge badge-success badge-sm">this browser</span>
          ) : (
            <form method="post">
              <input type="hidden" name="csrf" value={session.csrf} />
              <input type="hidden" name="action" value="revoke-session" />
              <input type="hidden" name="id" value={item.id} />
              <button class="btn btn-xs btn-error btn-outline" aria-label={`End session started ${day(item.createdAt)}`}>End</button>
            </form>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="mb-10" aria-labelledby="rename">
    <h2 id="rename" class="text-xl font-semibold mb-2">Rename account</h2>
    <form method="post" class="flex flex-wrap items-end gap-2">
      <input type="hidden" name="csrf" value={session.csrf} />
      <input type="hidden" name="action" value="rename" />
      <label class="flex flex-col gap-1 text-sm">New login<input name="login" class="input input-sm font-mono" required value={user.login} /></label>
      <button class="btn btn-sm btn-warning btn-outline">Rename</button>
    </form>
    <p class="text-sm text-base-content/70 mt-2">Old URLs of your profile and repositories redirect to the new name.</p>
  </section>

  {passkeysEnabled && <script type="application/json" id="login-config" set:html={configJson} />}
  {passkeysEnabled && <script is:inline set:html={PASSKEY_SCRIPT} />}
</Layout>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-forge",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 60000
  },
  "triggers": {
    "crons": [
      "17 3 * * *",
      "*/5 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "IMPORTS",
        "queue": "git-forge-imports"
      },
      {
        "binding": "JOBS",
        "queue": "git-forge-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "git-forge-imports",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      },
      {
        "queue": "git-forge-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "git-forge"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "git-forge",
      "migrations_dir": "../../packages/accounts/migrations"
    }
  ],
  "vars": {
    "MAX_LFS_OBJECT_BYTES": "104857600",
    "MIRROR_INTERVAL_MINUTES": "1440",
    "MIRROR_DEEP_CHECK_DAYS": "30",
    "MIRROR_UNIT_BYTES": "0",
    "ACTIONS": "true",
    "OIDC_ISSUER": "",
    "OIDC_CLIENT_ID": "",
    "OIDC_NAME": "",
    "SELF_SIGNUP": "false",
    "PASSKEYS": "true",
    "BREAK_GLASS_PUBLIC_KEY": "",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "forge@example.org",
    "PAGES_HOST": "",
    "PAGES_DOMAINS": "",
    "PAGES_MAX_AGE": "60"
  },
  "containers": [
    {
      "class_name": "RunnerContainer",
      "image": "./runner/Dockerfile",
      "instance_type": "basic",
      "max_instances": 4
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER",
        "class_name": "RunnerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RunnerContainer"
      ]
    }
  ],
  "dev": {
    "enable_containers": false
  },
  "env": {
    "alpha": {
      "name": "git-forge-alpha",
      "queues": {
        "producers": [
          {
            "binding": "IMPORTS",
            "queue": "git-forge-alpha-imports"
          },
          {
            "binding": "JOBS",
            "queue": "git-forge-alpha-jobs"
          }
        ],
        "consumers": [
          {
            "queue": "git-forge-alpha-imports",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3
          },
          {
            "queue": "git-forge-alpha-jobs",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 10
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "git-forge-alpha"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "git-forge-alpha",

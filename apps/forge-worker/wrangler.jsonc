        "MIRROR_UNIT_BYTES": "0",
        "ACTIONS": "true",
        "OIDC_ISSUER": "",
        "OIDC_CLIENT_ID": "",
        "OIDC_NAME": "",
        "SELF_SIGNUP": "false",
        "PASSKEYS": "true",
        "BREAK_GLASS_PUBLIC_KEY": "",
        "EMAIL_PROVIDER": "console",
        "EMAIL_FROM": "forge@example.org",
        "PAGES_HOST": "",
        "PAGES_DOMAINS": "",
        "PAGES_MAX_AGE": "60"
      },
      "containers": [
        {
          "class_name": "RunnerContainer",
          "image": "./runner/Dockerfile",

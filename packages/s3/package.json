{
  "name": "@git-forge/s3",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test/*": "./test/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:s3": "node --experimental-strip-types --no-warnings scripts/test-s3.ts",
    "s3:up": "docker compose -f compose.yaml up -d --wait",
    "s3:down": "docker compose -f compose.yaml down -v"
  },
  "dependencies": {
    "@git-forge/core": "workspace:*",
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

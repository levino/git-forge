{
  "name": "git-forge",
  "main": "dist/git-forge-worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "build": { "command": "sh build.sh" },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 60000 },
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "git-forge" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "git-forge",
      "migrations_dir": "dist/migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "IMPORTS", "queue": "git-forge-imports" },
      { "binding": "JOBS", "queue": "git-forge-jobs" }
    ],
    "consumers": [
      { "queue": "git-forge-imports", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3 },
      { "queue": "git-forge-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 10 }
    ]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "MAX_LFS_OBJECT_BYTES": "104857600", "MIRROR_INTERVAL_MINUTES": "1440", "MIRROR_DEEP_CHECK_DAYS": "30", "EMAIL_PROVIDER": "none" },
  "secrets": { "required": ["BOOTSTRAP_TOKEN"] }
}

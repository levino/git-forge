{
  "name": "git-forge",
  "main": "dist/git-forge-worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "build": { "command": "sh build.sh" },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 60000 },
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "git-forge" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "git-forge",
      "migrations_dir": "dist/migrations"
    }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": { "PUBLIC_READ": "true", "MAX_PUSH_BYTES": "16777216" },
  "secrets": { "required": ["ADMIN_TOKEN"] }
}

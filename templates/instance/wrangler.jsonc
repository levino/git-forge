{
  "name": "git-forge",
  "main": "dist/git-forge-worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "build": { "command": "sh build.sh" },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 60000 },
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "git-forge" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "git-forge",
      "migrations_dir": "dist/migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "IMPORTS", "queue": "git-forge-imports" }],
    "consumers": [{ "queue": "git-forge-imports", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3 }]
  },
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": { "MAX_PUSH_BYTES": "16777216", "MAX_LFS_OBJECT_BYTES": "104857600", "MIRROR_INTERVAL_MINUTES": "30" },
  "secrets": { "required": ["BOOTSTRAP_TOKEN"] }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-forge",
  "main": "apps/forge-worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 60000
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "git-forge"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "git-forge"
    }
  ],
  "vars": {
    "MAX_PUSH_BYTES": "16777216",
    "MAX_LFS_OBJECT_BYTES": "104857600",
    "MIRROR_INTERVAL_MINUTES": "30"
  }
}
